[Unit]
Description=NP1 Control Center read-only hardware broker
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=ncc
SupplementaryGroups=NEventWatcherCom apluser
RuntimeDirectory=np1-control
RuntimeDirectoryMode=0755
ExecStartPre=/bin/cp /overlay/owner-apps/np1-control/bin/ncc /run/np1-control/ncc
ExecStartPre=/bin/chmod 0755 /run/np1-control/ncc
ExecStartPre=-/bin/cp /overlay/owner-apps/np1-control/experimental/ncc-stock-start-helper /run/np1-control/stock-start-helper
ExecStartPre=-/bin/chmod 0700 /run/np1-control/stock-start-helper
ExecStart=/run/np1-control/ncc --mode broker --worker-uid @NCC_UID@
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ReadWritePaths=/run/np1-control
ReadWritePaths=/overlay/owner-apps/np1-control/private/led
ReadWritePaths=/overlay/owner-apps/np1-control/private/apn
ReadWritePaths=/overlay/owner-apps/np1-control/private/wifi
ReadWritePaths=/overlay/owner-apps/np1-control/private/nas
ReadWritePaths=/overlay/owner-apps/np1-control/private/ap
ReadWritePaths=/overlay/owner-apps/np1-control/private/ota-policy
ReadWritePaths=/pio_data/SYSTEM/Update
ReadWritePaths=/tmp/victoria
ReadOnlyPaths=/sys /mnt/sdcard /overlay
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE CAP_NET_RAW
UMask=0077
MemoryLimit=128M
CPUQuota=50%
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
