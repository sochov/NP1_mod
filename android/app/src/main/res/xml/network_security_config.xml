<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- NP1 hotspot (192.168.226.1) and Tailscale management IP use HTTP on port 80 inside the private management network -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
